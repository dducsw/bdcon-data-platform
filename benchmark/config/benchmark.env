# =============================================================================
# TPC-DS Benchmark Configuration
# Shared by both Spark and Trino jobs — keep resource budgets symmetric.
# =============================================================================

# ---------------------------------------------------------------------------
# Trino connection
# ---------------------------------------------------------------------------
TRINO_BASE_URL=http://trino:8080
TRINO_USER=benchmark
TRINO_SOURCE=tpcds-benchmark
TRINO_CATALOG=iceberg_hive
TRINO_SCHEMA=benchmark_tpcds_sf5

# ---------------------------------------------------------------------------
# Spark connection
# SPARK_MASTER điều khiển chế độ chạy:
#   local[4]                               → single-pod (debug / CI)
#   k8s://https://kubernetes.default.svc:443 → distributed trên K8s (production)
# ---------------------------------------------------------------------------
SPARK_MASTER=k8s://https://kubernetes.default.svc:443
SPARK_CATALOG=iceberg_hive
SPARK_SCHEMA=benchmark_tpcds_sf5

# Iceberg / MinIO
ICEBERG_URI=thrift://hive-metastore:9083
ICEBERG_WAREHOUSE=s3a://iceberg/lakehouse
MINIO_ENDPOINT=http://minio:9000

# ---------------------------------------------------------------------------
# Spark-on-Kubernetes: cấu hình executor
# ---------------------------------------------------------------------------
# Namespace K8s chứa executor pods
K8S_NAMESPACE=data-platform

# Image dùng cho executor pods (phải giống driver để tránh version mismatch)
SPARK_IMAGE=apache/spark:3.5.3-scala2.12-java17-python3-ubuntu

# Số lượng executor: 2 executors × 4 cores × 9g = 8 vCPU / 18g
# (tương đương Trino: 2 workers × 4 vCPU / 12g)
SPARK_EXECUTOR_INSTANCES=2
SPARK_EXECUTOR_CORES=4
SPARK_EXECUTOR_MEMORY=9g

# Path executor pod template bên trong container driver
# (file được mount từ ConfigMap spark-executor-pod-template)
SPARK_EXECUTOR_POD_TEMPLATE=/opt/spark/conf/executor-pod-template.yaml

# Driver resource (chạy trong Job pod)
SPARK_DRIVER_CORES=4
SPARK_DRIVER_MEMORY=7g

# ---------------------------------------------------------------------------
# TPC-DS source (for prepare step)
# ---------------------------------------------------------------------------
TPCDS_SOURCE_CATALOG=tpcds
TPCDS_SOURCE_SCHEMA=sf5

# ---------------------------------------------------------------------------
# Benchmark parameters — IDENTICAL for both engines
# ---------------------------------------------------------------------------
QUERY_LIST=benchmark/queries/tpcds/query_list.txt
WARMUP_RUNS=1
RUNS=3
QUERY_TIMEOUT_SECONDS=1800
WRAP_COUNT=false

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
RESULTS_DIR=benchmark/results